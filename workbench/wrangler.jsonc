{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "web-game-kit-workbench",
  "compatibility_date": "2026-07-01",
  // Account: Ntpon.stp@gmail.com — zone ntpon.com (ที่เดียวกับเว็บหลัก)
  "routes": [{ "pattern": "kit.ntpon.com", "custom_domain": true }],
  // Static SPA: vite builds to dist/, Workers serves it as static assets.
  // Deploy: pnpm build && npx wrangler deploy
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
